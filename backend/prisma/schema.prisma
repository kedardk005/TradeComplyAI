datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String
  name          String?
  created_at    DateTime  @default(now())
  products      Product[]
}

model Product {
  id             Int              @id @default(autoincrement())
  user_id        Int
  user           User             @relation(fields: [user_id], references: [id])
  name           String
  description    String
  category       String
  weight         Float
  dimensions     String
  declared_value Decimal
  origin_country String
  images         String[]
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  classifications Classification[]
  estimates      CostEstimate[]
}

model HSCodeReference {
  hs_code     String  @id
  description String
  chapter     String
  section     String
  notes       String?
}

model DutyRate {
  id                  String   @id @default(uuid())
  hs_code             String
  destination_country String
  duty_rate           String
  tax_rate            String?
  source              String
  updated_at          DateTime @updatedAt

  @@index([hs_code])
}

enum ClassificationStatus {
  pending_review
  confirmed
  overridden
}

model Classification {
  id                String               @id @default(uuid())
  product_id        Int
  product           Product              @relation(fields: [product_id], references: [id])
  hs_code           String
  confidence        Int
  reasoning         String
  ai_candidates     Json
  status            ClassificationStatus @default(pending_review)
  confirmed_hs_code String?
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt

  @@index([product_id])
}

enum FreightMode {
  air
  sea
}

model FreightRate {
  id                  String      @id @default(uuid())
  origin_country      String
  destination_country String
  mode                FreightMode
  rate_per_kg         Decimal
  min_charge          Decimal
  source              String
  updated_at          DateTime    @updatedAt

  @@index([origin_country, destination_country, mode])
}

model CostEstimate {
  id                String      @id @default(uuid())
  product_id        Int
  product           Product     @relation(fields: [product_id], references: [id])
  mode              FreightMode
  declared_value    Decimal
  duty_amount       Decimal
  mpf_amount        Decimal
  freight_cost      Decimal
  insurance_cost    Decimal
  total_landed_cost Decimal
  breakdown         Json
  created_at        DateTime    @default(now())

  @@index([product_id])
}

