datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String
  name          String?
  created_at    DateTime  @default(now())
  products      Product[]
}

model Product {
  id             Int      @id @default(autoincrement())
  user_id        Int
  user           User     @relation(fields: [user_id], references: [id])
  name           String
  description    String
  category       String
  weight         Float
  dimensions     String
  declared_value Decimal
  origin_country String
  images         String[]
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model HSCodeReference {
  hs_code     String  @id
  description String
  chapter     String
  section     String
  notes       String?
}

model DutyRate {
  id                  String   @id @default(uuid())
  hs_code             String
  destination_country String
  duty_rate           String
  tax_rate            String?
  source              String
  updated_at          DateTime @updatedAt

  @@index([hs_code])
}
