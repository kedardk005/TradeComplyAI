# Server configuration
PORT=5000

# Authentication secrets
JWT_SECRET="your_placeholder_jwt_secret_here"

# AI services configuration
GROQ_API_KEY="your_placeholder_groq_api_key_here"
AI_SERVICE_URL="http://localhost:8000"
